{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvestigationQueue",
  "type": "object",
  "required": ["items"],
  "properties": {
    "schema_version": { "type": "integer" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "kind"],
        "properties": {
          "id": { "type": "string" },
          "priority": { "enum": ["high", "medium", "low"] },
          "kind": { "type": "string" },
          "question": { "type": "string" },
          "target": { "type": "object" },
          "suggested_action": { "type": "object" },
          "status": { "enum": ["open", "in_progress", "done", "wont_fix"] },
          "blocking": { "type": "boolean" },
          "created_by_stage": { "type": "string" }
        }
      }
    }
  }
}
