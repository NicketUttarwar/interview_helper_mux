{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisState",
  "type": "object",
  "required": ["schema_version", "themes", "major_questions", "style", "narrative"],
  "properties": {
    "schema_version": { "type": "integer" },
    "run_id": { "type": "string" },
    "meta": {
      "type": "object",
      "properties": {
        "operator_verified": { "type": "boolean" },
        "operator_locked_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "last_updated_stage": { "type": "string" },
        "analysis_pass": { "type": "integer" }
      }
    },
    "interview_identity": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "one_line_summary": { "type": "string" },
        "source_audio_note": { "type": "string" }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "segment_ids": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number" },
          "sources": { "type": "array", "items": { "type": "string" } },
          "evidence_windows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "window_id": { "type": "string" },
                "start_ms": { "type": "integer" },
                "end_ms": { "type": "integer" },
                "retrieval_score": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "major_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "segment_ids": { "type": "array" },
          "priority": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "tone": { "type": "string" },
        "tone_class": {
          "type": "string",
          "enum": [
            "journalistic",
            "conversational",
            "investor",
            "technical",
            "human_interest"
          ]
        },
        "format_class": {
          "type": "string",
          "enum": [
            "one_on_one",
            "panel",
            "fireside",
            "technical_deep_dive",
            "media_profile",
            "debate"
          ]
        },
        "pacing": { "type": "string" },
        "format_notes": { "type": "string" },
        "interviewer_style": { "type": "string" },
        "interviewee_style": { "type": "string" }
      }
    },
    "narrative": {
      "type": "object",
      "properties": {
        "thesis": { "type": "string" },
        "audience": { "type": "string" },
        "emotional_beats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "description": { "type": "string" },
              "segment_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "key_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "claim": { "type": "string" },
              "claim_type": {
                "enum": ["fact", "opinion", "prediction", "anecdote", "definition"]
              },
              "segment_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "topic_relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from_topic": { "type": "string" },
              "to_topic": { "type": "string" },
              "relation": {
                "enum": ["supports", "contradicts", "prerequisite", "example_of", "returns_to"]
              },
              "description": { "type": "string" },
              "evidence_segment_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "entities": { "type": "array" },
    "speakers": { "type": "array" },
    "conversation_profile": { "type": "object" },
    "conversation_hypotheses": { "type": "array" },
    "confirmed_conversation_hypothesis_id": { "type": ["string", "null"] },
    "gap_sensitivity": { "type": "object" },
    "hypotheses": { "type": "array" },
    "open_questions": { "type": "array" },
    "operator_notes": { "type": "string" },
    "coherence_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["topic_drift", "claim_contradiction", "missing_callback"]
          },
          "time_ms": { "type": "integer" },
          "window_id": { "type": ["string", "null"] },
          "theme_id": { "type": ["string", "null"] },
          "claim_id": { "type": ["string", "null"] },
          "confidence": { "type": "number" },
          "blocking": { "type": "boolean" },
          "evidence": { "type": "object" },
          "status": { "type": "string", "enum": ["open", "resolved"] }
        }
      }
    },
    "completion": {
      "type": "object",
      "properties": {
        "analysis_ready": { "type": "boolean" },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
