{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalDigestCompressorResponse",
  "type": "object",
  "required": ["compressed_digest", "confidence", "reason"],
  "properties": {
    "compressed_digest": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string" },
    "episode_structure_note": { "type": "string" }
  }
}
