{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "needs_input",
        "blocked"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "strategy_summary",
        "through_line",
        "talking_points",
        "hard_excludes",
        "warnings"
      ],
      "properties": {
        "strategy_summary": {
          "type": "string",
          "description": "One-paragraph holistic read of what this interview is about and what the master must deliver."
        },
        "through_line": {
          "type": [
            "string",
            "null"
          ],
          "description": "Single sentence spine the episode should follow."
        },
        "talking_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "talking_point_id",
              "title",
              "importance",
              "why_it_matters",
              "evidence_quotes",
              "approx_time_hint_ms",
              "exclude_reason_if_dropped"
            ],
            "properties": {
              "talking_point_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "importance": {
                "type": "string",
                "enum": [
                  "must_keep",
                  "should_keep",
                  "optional"
                ]
              },
              "why_it_matters": {
                "type": "string"
              },
              "evidence_quotes": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "approx_time_hint_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Rough transcript location hint; ideal_cuts will refine exact windows."
              },
              "exclude_reason_if_dropped": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "hard_excludes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "approx_time_hint_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "reason",
              "approx_time_hint_ms",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "memory_updates": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "rerun_stage",
              "operator",
              "transcript_excerpt",
              "human_fact"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "blocking": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "params": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "stage",
          "reason",
          "blocking",
          "params"
        ],
        "additionalProperties": false
      }
    },
    "follow_up_investigations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "reasoning_summary": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "artifacts",
    "memory_updates",
    "needs",
    "follow_up_investigations",
    "confidence",
    "reasoning_summary"
  ],
  "additionalProperties": false
}
