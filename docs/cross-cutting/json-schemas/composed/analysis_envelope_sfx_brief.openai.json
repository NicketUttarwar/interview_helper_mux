{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "needs_input",
        "blocked"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "cold_open",
        "transitions",
        "outro"
      ],
      "properties": {
        "cold_open": {
          "type": "object",
          "properties": {
            "duration_ms": {
              "type": [
                "integer",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "mood": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "duration_ms",
            "description",
            "mood"
          ],
          "additionalProperties": false
        },
        "transitions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "from_clip_rank",
              "to_clip_rank",
              "duration_ms",
              "sfx_types",
              "description",
              "duck_under_speech_db"
            ],
            "properties": {
              "from_clip_rank": {
                "type": "integer"
              },
              "to_clip_rank": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "integer"
              },
              "sfx_types": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              },
              "duck_under_speech_db": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "outro": {
          "type": "object",
          "properties": {
            "duration_ms": {
              "type": [
                "integer",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "duration_ms",
            "description"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "memory_updates": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "rerun_stage",
              "operator",
              "transcript_excerpt",
              "human_fact"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "blocking": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "params": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "stage",
          "reason",
          "blocking",
          "params"
        ],
        "additionalProperties": false
      }
    },
    "follow_up_investigations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "reasoning_summary": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "artifacts",
    "memory_updates",
    "needs",
    "follow_up_investigations",
    "confidence",
    "reasoning_summary"
  ],
  "additionalProperties": false
}
