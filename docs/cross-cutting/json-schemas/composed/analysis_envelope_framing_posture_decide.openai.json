{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "needs_input",
        "blocked"
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "recommended_framing",
        "posture_hint",
        "rationale_plain",
        "reason_codes",
        "signals_summary",
        "decided_by",
        "advisory_only",
        "decided_at"
      ],
      "properties": {
        "recommended_framing": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "sparse"
          ]
        },
        "posture_hint": {
          "type": "string",
          "enum": [
            "framing_full",
            "framing_sparse",
            "native_only"
          ]
        },
        "rationale_plain": {
          "type": "string",
          "minLength": 8
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "signals_summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "decided_by": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "llm_advisory",
            "deterministic_monologue",
            "homunculus_skip",
            "feature_disabled",
            "operator_g_framing",
            "forced_skip"
          ]
        },
        "advisory_only": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "memory_updates": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "rerun_stage",
              "operator",
              "transcript_excerpt",
              "human_fact"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "blocking": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "params": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "stage",
          "reason",
          "blocking",
          "params"
        ],
        "additionalProperties": false
      }
    },
    "follow_up_investigations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "reasoning_summary": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "artifacts",
    "memory_updates",
    "needs",
    "follow_up_investigations",
    "confidence",
    "reasoning_summary"
  ],
  "additionalProperties": false
}
