        "version",
        "verdict",
        "skipped",
        "reason",
        "findings",
        "directives",
        "applied_directives",
        "llm_calls",
        "remaster_round",
        "error",
        "generated_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "verdict": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pass",
            "soft_pass",
            "fail",
            "remux_suggested",
            "unavailable"
          ]
        },
        "skipped": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "findings": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          }
        },
        "directives": {
          "type": [
            "array",
            "null"
          ],
          "items": {
