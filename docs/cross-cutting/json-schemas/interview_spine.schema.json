{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewSpine",
  "type": "object",
  "required": [
    "schema_version",
    "derived_from",
    "encoders",
    "window_policy",
    "windows",
    "boundary_events",
    "retrieval",
    "speaker_stats"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "derived_from": {
      "type": "object",
      "required": ["normalized_wav", "transcript", "computed_at", "stage"],
      "properties": {
        "normalized_wav": { "type": "string" },
        "normalized_wav_sha256": { "type": "string" },
        "transcript": { "type": "string" },
        "transcript_sha256": { "type": "string" },
        "source_acoustic_profile": { "type": "string" },
        "source_acoustic_profile_sha256": { "type": "string" },
        "preclean_isolated": { "type": ["string", "null"] },
        "preclean_isolated_sha256": { "type": ["string", "null"] },
        "computed_at": { "type": "string" },
        "stage": { "type": "string", "const": "interview_spine_build" }
      }
    },
    "encoders": {
      "type": "object",
      "properties": {
        "dsp": { "type": "string" },
        "clap": { "type": ["string", "null"] },
        "ssl": { "type": ["string", "null"] }
      }
    },
    "window_policy": {
      "type": "object",
      "required": ["window_sec", "hop_sec", "align_to"],
      "properties": {
        "window_sec": { "type": "number", "minimum": 1 },
        "hop_sec": { "type": "number", "minimum": 0.5 },
        "align_to": { "type": "string", "enum": ["words"] }
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["window_id", "start_ms", "end_ms", "text_span", "features"],
        "properties": {
          "window_id": { "type": "string" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "speaker_id": { "type": ["string", "null"] },
          "text_span": { "type": "string" },
          "features": {
            "type": "object",
            "properties": {
              "rms_p50": { "type": "number" },
              "pause_before_ms": { "type": "number", "minimum": 0 },
              "speaking_rate_wpm": { "type": "number", "minimum": 0 },
              "f0_median_hz": { "type": ["number", "null"] }
            }
          },
          "embedding_ref": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "boundary_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time_ms", "type", "confidence", "sources"],
        "properties": {
          "time_ms": { "type": "integer", "minimum": 0 },
          "type": {
            "type": "string",
            "enum": [
              "silence_valley",
              "speaker_turn",
              "pause_ladder",
              "prosody_shift",
              "trust_dip",
              "novelty_hint",
              "topic_shift_hint"
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sources": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "window_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "model_id": { "type": ["string", "null"] },
        "sidecar_path": { "type": ["string", "null"] },
        "vector_dim": { "type": ["integer", "null"], "minimum": 1 },
        "window_count": { "type": "integer", "minimum": 0 }
      }
    },
    "speaker_stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["speaker_id"],
        "properties": {
          "speaker_id": { "type": "string" },
          "turn_count": { "type": "integer", "minimum": 0 },
          "avg_wpm": { "type": "number", "minimum": 0 },
          "register_hint": { "type": "string" }
        }
      }
    }
  }
}
