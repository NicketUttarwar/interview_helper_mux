{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoundDesignPlan",
  "type": "object",
  "required": ["version", "coherence", "palettes", "assets", "flow_plans", "generated"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "coherence": {
      "type": "object",
      "required": ["sonic_identity", "primary_mood", "density"],
      "properties": {
        "sonic_identity": { "type": "string" },
        "primary_mood": { "type": "string" },
        "density": { "type": "string" }
      },
      "additionalProperties": true
    },
    "palettes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "palette_id",
          "theme_label",
          "keywords",
          "segment_ids",
          "ambient_description",
          "accent_description",
          "avoid"
        ],
        "properties": {
          "palette_id": { "type": "string" },
          "theme_label": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "segment_ids": { "type": "array", "items": { "type": "string" } },
          "ambient_description": { "type": "string" },
          "accent_description": { "type": "string" },
          "avoid": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "role", "description", "duration_seconds"],
        "properties": {
          "asset_id": { "type": "string" },
          "role": { "type": "string" },
          "palette_id": { "type": "string" },
          "description": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 0.1 },
          "reuse_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "flow_plans": {
      "type": "object",
      "required": ["flow1", "flow2"],
      "properties": {
        "flow1": {
          "type": "object",
          "required": ["profile", "cues"],
          "properties": {
            "profile": { "type": "string" },
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cue_id", "asset_id", "placement"],
                "properties": {
                  "cue_id": { "type": "string" },
                  "asset_id": { "type": "string" },
                  "placement": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "flow2": {
          "type": "object",
          "required": ["profile", "cues"],
          "properties": {
            "profile": { "type": "string" },
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cue_id", "asset_id", "placement"],
                "properties": {
                  "cue_id": { "type": "string" },
                  "asset_id": { "type": "string" },
                  "placement": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "generated": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
