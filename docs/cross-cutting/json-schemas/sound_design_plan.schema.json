{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoundDesignPlan",
  "type": "object",
  "required": ["version", "coherence", "palettes", "assets", "flow_plans", "generated"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "coherence": {
      "type": "object",
      "required": ["sonic_identity", "primary_mood", "density"],
      "properties": {
        "sonic_identity": { "type": "string" },
        "primary_mood": { "type": "string" },
        "density": { "type": "string" },
        "scenario_bucket": {
          "type": "string",
          "description": "Atlas bucket from sonic_context (e.g. panel, fireside)."
        },
        "tag_lineage": {
          "type": "array",
          "items": { "type": "string" },
          "description": "tag_id values from sonic_context used when planning palettes."
        },
        "sonic_context_hash": {
          "type": "string",
          "description": "Hash of understanding/sonic_context.json at palette/plan time."
        }
      },
      "additionalProperties": true
    },
    "palettes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "palette_id",
          "theme_label",
          "keywords",
          "segment_ids",
          "ambient_description",
          "accent_description",
          "avoid"
        ],
        "properties": {
          "palette_id": { "type": "string" },
          "theme_label": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "segment_ids": { "type": "array", "items": { "type": "string" } },
          "ambient_description": { "type": "string" },
          "accent_description": { "type": "string" },
          "avoid": { "type": "array", "items": { "type": "string" } },
          "tag_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "References tag_registry[].tag_id in sonic_context."
          },
          "sonic_bucket": {
            "type": "string",
            "enum": ["ambient_territory", "accent_texture", "transition_family"]
          }
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "role", "description", "duration_seconds"],
        "properties": {
          "asset_id": { "type": "string" },
          "role": { "type": "string" },
          "palette_id": { "type": "string" },
          "description": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 0.1 },
          "reuse_note": { "type": "string" },
          "generation_notes": {
            "type": "string",
            "description": "Optional MMAudio hints: loop seam, trim tail ms, intended CFG band, ducking"
          },
          "tag_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scenario_constraints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cue_opportunity_refs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Opaque refs to sonic_context cue_opportunities (kind+segment_id or rank pair)."
          }
        },
        "additionalProperties": true
      }
    },
    "flow_plans": {
      "type": "object",
      "required": ["flow1", "flow2"],
      "properties": {
        "flow1": {
          "type": "object",
          "required": ["profile", "cues"],
          "properties": {
            "profile": { "type": "string" },
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cue_id", "asset_id", "placement"],
                "properties": {
                  "cue_id": { "type": "string" },
                  "asset_id": { "type": "string" },
                  "placement": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "flow2": {
          "type": "object",
          "required": ["profile", "cues"],
          "properties": {
            "profile": { "type": "string" },
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cue_id", "asset_id", "placement"],
                "properties": {
                  "cue_id": { "type": "string" },
                  "asset_id": { "type": "string" },
                  "placement": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "generated": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
