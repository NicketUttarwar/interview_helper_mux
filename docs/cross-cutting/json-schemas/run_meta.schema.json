{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunMeta",
  "type": "object",
  "properties": {
    "execution_id": { "type": "string" },
    "execution_number": { "type": ["integer", "null"] },
    "input_audio_path": { "type": "string" },
    "source_audio_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_audio_hash_short": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
    "storage_root": { "type": "string" },
    "stage_reuse": {
      "type": "object",
      "description": "Per-stage reuse decisions: stage_id -> { action: accept|decline, source_run_id?, at }",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "action": { "enum": ["accept", "decline"] },
          "source_run_id": { "type": "string" },
          "at": { "type": "string" }
        },
        "required": ["action", "at"]
      }
    },
    "pending_write_approval": { "type": "object" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "REMOVED_selected_flow": { "enum": ["podcast", "flow2", "flow3"] },
    "selected_at": { "type": "string" },
    "REMOVED_flow_intent": { "enum": ["podcast", "flow2", "flow3"] },
    "REMOVED_flow_intent_at": { "type": "string" },
    "operator_phase": {
      "enum": ["prepare", "understand", "complete", "create", "polish", "ship"]
    },
    "operator_phase_updated_at": { "type": "string" },
    "journey_milestones": { "type": "object" },
    "preview_listened_at": { "type": "string" },
    "audio_preclean": { "type": "object" },
    "sfx_prompt_review": { "type": "object" },
    "sfx_listen_results": { "type": "array" },
    "sfx_regen_asset_ids": { "type": "array", "items": { "type": "string" } },
    "sfx_generation_meta": { "type": "object" },
    "sfx_refine_attempts": { "type": "object" },
    "sfx_generation_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": { "type": "string" },
          "reason": { "type": "string" },
          "at": { "type": "string" },
          "stage": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "sonic_context_hash": {
      "type": "string",
      "description": "Hash of understanding/sonic_context.json at last sound spend."
    },
    "post_listen_gate_state": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["soft", "warn", "block_mix"] },
        "blocked_assets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "qc_summaries": { "type": "object" },
    "run_mode": { "type": "string" },
    "full_auto": { "type": "boolean" },
    "homunculus_version": {
      "type": "string",
      "description": "Brain selected at Start: 0.0.0 original linear pipeline (default); 0.1.0 first homunculus. Never changes mid-run."
    },
    "homunculus_kind": {
      "type": "string",
      "enum": ["original_pipeline", "homunculus"]
    }
  },
  "additionalProperties": true
}
