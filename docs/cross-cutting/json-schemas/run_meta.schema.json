{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunMeta",
  "type": "object",
  "properties": {
    "execution_id": { "type": "string" },
    "execution_number": { "type": ["integer", "null"] },
    "input_audio_path": { "type": "string" },
    "storage_root": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "selected_flow": { "enum": ["flow1", "flow2", "flow3"] },
    "selected_at": { "type": "string" },
    "flow_intent": { "enum": ["flow1", "flow2", "flow3"] },
    "flow_intent_at": { "type": "string" },
    "operator_phase": {
      "enum": ["prepare", "understand", "complete", "create", "polish", "ship"]
    },
    "operator_phase_updated_at": { "type": "string" },
    "journey_milestones": { "type": "object" },
    "preview_listened_at": { "type": "string" },
    "audio_preclean": { "type": "object" },
    "elevenlabs_prompt_review": { "type": "object" },
    "elevenlabs_listen_results": { "type": "array" },
    "qc_summaries": { "type": "object" }
  },
  "additionalProperties": true
}
