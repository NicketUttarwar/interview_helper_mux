{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GapReport",
  "type": "object",
  "required": ["interviewer_lines"],
  "properties": {
    "interviewer_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_type", "text", "targets_segment_id", "placement", "delivery"],
        "properties": {
          "line_id": { "type": "string" },
          "gap_type": { "type": "string" },
          "line_category": {
            "type": "string",
            "enum": [
              "framing_question",
              "context_setup",
              "segment_summary",
              "episode_preface",
              "story_bridge",
              "extracted_context"
            ]
          },
          "text": { "type": "string" },
          "targets_segment_id": { "type": "string" },
          "placement": { "enum": ["before", "after"] },
          "delivery": { "enum": ["record", "synthesize"] },
          "rationale": { "type": "string" },
          "voice_speaker_id": { "type": "string" },
          "supports_segment_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "replaces_source_segments": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimated_duration_sec": { "type": "number", "minimum": 0 },
          "extracted_from": {
            "type": "object",
            "properties": {
              "artifact": { "type": "string" },
              "path": { "type": "string" }
            }
          },
          "act_context": { "type": "integer", "minimum": 1, "maximum": 5 },
          "suggested_tone": { "type": "string", "enum": ["analytical", "consumer", "neutral"] },
          "trim_hint_ms": { "type": "number" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "blocking": { "type": "boolean" },
          "skipped_optional": { "type": "boolean" }
        }
      }
    }
  }
}
