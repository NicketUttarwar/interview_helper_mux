{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GapReport",
  "type": "object",
  "required": ["interviewer_lines"],
  "properties": {
    "interviewer_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_type", "text", "targets_segment_id", "placement", "delivery"],
        "properties": {
          "line_id": { "type": "string" },
          "gap_type": { "type": "string" },
          "text": { "type": "string" },
          "targets_segment_id": { "type": "string" },
          "placement": { "enum": ["before", "after"] },
          "delivery": { "enum": ["record", "synthesize"] },
          "rationale": { "type": "string" },
          "line_id": { "type": "string" },
          "voice_speaker_id": { "type": "string" },
          "act_context": { "type": "integer", "minimum": 1, "maximum": 5 },
          "suggested_tone": { "type": "string", "enum": ["analytical", "consumer", "neutral"] },
          "trim_hint_ms": { "type": "number" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "G1 blocking uses high|critical when delivery=record; missing severity on record defaults to high at gate time."
          },
          "blocking": {
            "type": "boolean",
            "description": "When true, force VO required; when false, never block G1 even if severity is high."
          },
          "skipped_optional": {
            "type": "boolean",
            "description": "Operator skipped optional (non-blocking) VO via gui.g1.skip_optional."
          }
        }
      }
    }
  }
}
