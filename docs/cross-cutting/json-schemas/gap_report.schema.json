{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GapReport",
  "description": "Listener-facing synthetic VO lines. Code-enforced: non-skipped interviewer_lines must have unique sentence_keys across the corpus (with transitions); text must not reference chapters/clips/segments/edit metadata and must only convey grounded contextual facts plus a layup into the next native beat.",
  "type": "object",
  "required": ["interviewer_lines"],
  "properties": {
    "interviewer_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_type", "text", "targets_segment_id", "placement", "delivery"],
        "properties": {
          "line_id": { "type": "string" },
          "gap_type": { "type": "string" },
          "line_category": {
            "type": "string",
            "enum": [
              "framing_question",
              "context_setup",
              "segment_summary",
              "episode_preface",
              "story_bridge",
              "extracted_context"
            ]
          },
          "text": {
            "type": "string",
            "description": "Speakable host VO only — contextual facts + forward layup; never chapter/clip/segment/construction metadata."
          },
          "targets_segment_id": { "type": "string" },
          "placement": { "enum": ["before", "after"] },
          "delivery": { "enum": ["record", "synthesize"] },
          "spoken_copy_guard": {
            "type": "object",
            "description": "Optional audit of the last spoken_copy_guard decision for this line.",
            "properties": {
              "action": { "type": "string" },
              "script_hash": { "type": "string" },
              "context_hash": { "type": "string" }
            },
            "additionalProperties": true
          },
          "rationale": { "type": "string" },
          "voice_speaker_id": { "type": "string" },
          "supports_segment_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "replaces_source_segments": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimated_duration_sec": { "type": "number", "minimum": 0 },
          "extracted_from": {
            "type": "object",
            "properties": {
              "artifact": { "type": "string" },
              "path": { "type": "string" }
            }
          },
          "act_context": { "type": "integer", "minimum": 1, "maximum": 5 },
          "suggested_tone": { "type": "string", "enum": ["analytical", "consumer", "neutral"] },
          "trim_hint_ms": { "type": "number" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "blocking": { "type": "boolean" },
          "skipped_optional": { "type": "boolean" },
          "origin": { "type": "string" },
          "nugget_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recovery_of_talking_point_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "prior_segment_id": { "type": ["string", "null"] },
          "prior_impact_beat": { "type": "boolean" },
          "prior_complete_thought": { "type": "boolean" },
          "density_forced": { "type": "boolean" }
        }
      }
    },
    "nugget_layup_authority": { "type": "boolean" }
  }
}
