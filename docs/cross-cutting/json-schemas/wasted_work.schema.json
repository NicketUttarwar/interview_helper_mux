{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WastedWorkLedger",
  "type": "object",
  "properties": {
    "version": { "type": "integer" },
    "updated_at": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string" },
          "event": {
            "type": "string",
            "minLength": 1,
            "description": "Ledger event id (open vocabulary; thrash + vernacular + residual kinds)"
          },
          "stage": { "type": "string" },
          "detail": { "type": "object" }
        },
        "required": ["event"],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
