{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TalkingPointsArtifact",
  "type": "object",
  "required": ["talking_points", "strategy_summary"],
  "properties": {
    "strategy_summary": {
      "type": "string",
      "description": "One-paragraph holistic read of what this interview is about and what the master must deliver."
    },
    "through_line": {
      "type": "string",
      "description": "Single sentence spine the episode should follow."
    },
    "talking_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["talking_point_id", "title", "importance", "why_it_matters"],
        "properties": {
          "talking_point_id": { "type": "string" },
          "title": { "type": "string" },
          "importance": {
            "type": "string",
            "enum": ["must_keep", "should_keep", "optional"]
          },
          "why_it_matters": { "type": "string" },
          "evidence_quotes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "approx_time_hint_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "Rough transcript location hint; ideal_cuts will refine exact windows."
          },
          "exclude_reason_if_dropped": { "type": "string" }
        }
      }
    },
    "hard_excludes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": { "type": "string" },
          "approx_time_hint_ms": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
