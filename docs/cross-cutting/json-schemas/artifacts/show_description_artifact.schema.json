{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-helper-mux.local/schemas/artifacts/show_description_artifact.schema.json",
  "title": "ShowDescriptionArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description_markdown",
    "word_count",
    "hook_sentence",
    "themes_highlighted",
    "audience_pitch",
    "evidence_segment_ids",
    "tone",
    "confidence"
  ],
  "properties": {
    "title_suggestion": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description_markdown": {
      "type": "string",
      "minLength": 400,
      "maxLength": 4000,
      "description": "Third-person show blurb; target 180-220 words (150-250 enforced at validation time in code)"
    },
    "word_count": {
      "type": "integer",
      "minimum": 150,
      "maximum": 250
    },
    "hook_sentence": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "themes_highlighted": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "minItems": 1,
      "maxItems": 6
    },
    "audience_pitch": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "evidence_segment_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^seg_" },
      "minItems": 1,
      "maxItems": 24
    },
    "tone": {
      "type": "string",
      "enum": [
        "journalistic",
        "conversational",
        "investor",
        "technical",
        "human_interest"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
