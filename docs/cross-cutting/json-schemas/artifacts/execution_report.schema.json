{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionReport",
  "type": "object",
  "required": ["version", "outcome", "run_id"],
  "properties": {
    "version": { "type": "integer" },
    "written_at": { "type": "string" },
    "run_id": { "type": "string" },
    "run_dir": { "type": "string" },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "halted_identical_failure",
        "halted_quality",
        "halted_needs_operator",
        "incomplete_artifacts"
      ]
    },
    "halt_stage": { "type": "string" },
    "root_cause": { "type": "string" },
    "producer_artifact": { "type": "string" },
    "homunculus_version": { "type": "string" },
    "full_auto": { "type": "boolean" },
    "g0": { "type": "object", "additionalProperties": true },
    "source_profile": { "type": "object", "additionalProperties": true },
    "ship": { "type": "object", "additionalProperties": true },
    "identical_failures": { "type": "array", "items": { "type": "object" } },
    "decisions": { "type": "array", "items": { "type": "object" } },
    "homunculus_issues": { "type": "object", "additionalProperties": true },
    "needs_operator": { "type": "boolean" },
    "research_next": { "type": "array", "items": { "type": "string" } },
    "extra": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
