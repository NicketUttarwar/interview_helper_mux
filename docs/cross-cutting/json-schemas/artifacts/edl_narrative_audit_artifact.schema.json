{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdlNarrativeAuditArtifact",
  "type": "object",
  "required": ["verdict", "blocking_issues", "warnings", "recommended_actions", "reasoning_summary"],
  "properties": {
    "verdict": { "enum": ["pass", "warn", "fail"] },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "evidence", "recommended_action"],
        "properties": {
          "issue": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "recommended_action": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array" },
    "recommended_actions": { "type": "array", "items": { "type": "string" } },
    "reasoning_summary": { "type": "string" }
  }
}
