{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MmaudioQaArtifact",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": { "type": "integer" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "verdict"],
        "properties": {
          "asset_id": { "type": "string" },
          "role": { "type": "string" },
          "verdict": { "enum": ["pass", "warn", "fail"] },
          "generation_status": {
            "type": "string",
            "enum": ["pass", "failed", "placeholder"],
            "description": "Subprocess outcome; placeholder/silent WAV must not pass as success."
          },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "action": { "type": "string" },
          "actual_duration_seconds": { "type": "number" },
          "suggested_trim_ms": { "type": "integer" },
          "suggested_level_db_delta": { "type": "number" },
          "suggested_crossfade_ms": { "type": "integer" },
          "suggested_cfg_delta": { "type": "number" },
          "speech_band_ratio": { "type": "number" },
          "theme_fit_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Deterministic keyword/spectral theme fit (Tier 1 QA)."
          },
          "loop_seam_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Bed loop head/tail RMS continuity."
          },
          "silence_detected": {
            "type": "boolean",
            "description": "True when RMS below silence threshold (failed generation)."
          },
          "spectral_bucket_match": { "type": "boolean" },
          "semantic_similarity": {
            "type": "number",
            "minimum": -1,
            "maximum": 1,
            "description": "CLAP cosine similarity between sfx_prompt and generated WAV (Tier 2 QA)."
          },
          "semantic_qa_verdict": {
            "type": "string",
            "enum": ["pass", "warn", "fail", "skipped"]
          },
          "semantic_qa_skipped_reason": { "type": "string" },
          "semantic_qa_model_id": { "type": "string" },
          "semantic_qa_threshold": { "type": "number" },
          "recommended_action": {
            "type": "string",
            "enum": ["pass", "refine", "regenerate", "trim_hint"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
