{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JunctionSnipQA",
  "type": "object",
  "required": ["version", "generated_at"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "mode": { "type": "string" },
    "skipped": { "type": "boolean" },
    "reason": { "type": "string" },
    "pace_class": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "remaster_rounds": { "type": "integer", "minimum": 0 },
    "llm_calls": {
      "type": "integer",
      "minimum": 0,
      "description": "Must stay O(1) — feel audit only, never per-edge."
    },
    "advisory": { "type": "boolean" },
    "blocking": { "type": "boolean" },
    "generated_at": { "type": "string" }
  },
  "additionalProperties": true
}
