{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnderbedABQCArtifact",
  "type": "object",
  "required": [
    "version",
    "automated",
    "verdict",
    "windows_checked",
    "masking_windows",
    "inaudible_windows",
    "settings",
    "windows"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "automated": { "type": "boolean", "const": true },
    "verdict": {
      "type": "string",
      "enum": ["pass", "remux_masking", "remux_lift"]
    },
    "reason": { "type": "string" },
    "remux_cycle": { "type": "integer", "minimum": 0 },
    "windows_checked": { "type": "integer", "minimum": 0 },
    "masking_windows": { "type": "integer", "minimum": 0 },
    "inaudible_windows": { "type": "integer", "minimum": 0 },
    "settings": { "type": "object" },
    "adjustments": { "type": "object" },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "window_id",
          "asset_id",
          "start_ms",
          "end_ms",
          "speech_baseline_dbfs",
          "rendered_bed_level_dbfs",
          "rendered_bed_residual_dbfs",
          "speech_band_masking_excess_db",
          "verdict",
          "reason"
        ],
        "properties": {
          "window_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "segment_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "speech_baseline_dbfs": { "type": "number" },
          "rendered_bed_level_dbfs": { "type": "number" },
          "rendered_bed_residual_dbfs": { "type": "number" },
          "speech_band_masking_excess_db": { "type": "number" },
          "speech_active": { "type": "boolean" },
          "verdict": {
            "type": "string",
            "enum": ["pass", "masking", "inaudible"]
          },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
