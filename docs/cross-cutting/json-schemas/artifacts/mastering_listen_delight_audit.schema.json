{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasteringListenDelightAudit",
  "type": "object",
  "required": [
    "version",
    "advisory",
    "blocking",
    "generated_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "off",
        "advisory",
        "authoritative"
      ]
    },
    "advisory": {
      "type": "boolean"
    },
    "blocking": {
      "type": "boolean"
    },
    "narrative_mode": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "overall": {
      "type": "number"
    },
    "overall_min": {
      "type": "number"
    },
    "dimension_floors": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "failed_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passed": {
      "type": "boolean"
    },
    "finishability": {
      "type": "number"
    },
    "fatigue_risk": {
      "type": "number"
    },
    "mode_audible": {
      "type": "boolean"
    },
    "recommendability": {
      "type": "number"
    },
    "mode_consistency": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
