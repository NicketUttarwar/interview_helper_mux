{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentBriefArtifact",
  "type": "object",
  "required": ["thesis", "topics"],
  "properties": {
    "thesis": { "type": "string", "minLength": 1 },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "approx_time_range": { "type": "string" },
          "segment_ids": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number" }
        }
      }
    },
    "topic_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_topic", "to_topic", "relation"],
        "properties": {
          "from_topic": { "type": "string" },
          "to_topic": { "type": "string" },
          "relation": {
            "enum": ["supports", "contradicts", "prerequisite", "example_of", "returns_to"]
          },
          "description": { "type": "string" },
          "evidence_segment_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "key_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "claim_type": {
            "enum": ["fact", "opinion", "prediction", "anecdote", "definition"]
          },
          "speaker_role": { "enum": ["interviewee", "interviewer"] },
          "segment_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_segment_ids": { "type": "array", "items": { "type": "string" } },
          "depends_on_claim_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "audience": { "type": ["string", "null"] },
    "jargon_glossary": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["term", "plain_definition"],
        "properties": {
          "term": { "type": "string" },
          "plain_definition": { "type": "string" },
          "first_segment_id": { "type": ["string", "null"] }
        }
      }
    },
    "emotional_beats": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "segment_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
