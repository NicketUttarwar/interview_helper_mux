{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentBriefArtifact",
  "type": "object",
  "required": ["thesis", "topics"],
  "properties": {
    "thesis": { "type": "string", "minLength": 1 },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "approx_time_range": {
            "type": "string",
            "minLength": 1,
            "description": "mm:ss-mm:ss (or m:ss) span in the source transcript where this topic is discussed. Required before seg_* ids exist.",
            "examples": ["02:15-04:40"]
          },
          "segment_ids": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number" }
        }
      }
    },
    "topic_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_topic", "to_topic", "relation"],
        "properties": {
          "from_topic": { "type": "string" },
          "to_topic": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": ["supports", "contradicts", "prerequisite", "example_of", "returns_to"]
          },
          "description": { "type": "string" },
          "evidence_segment_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "key_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "claim_type": {
            "type": "string",
            "enum": ["fact", "opinion", "prediction", "anecdote", "definition"]
          },
          "speaker_role": { "type": "string", "enum": ["interviewee", "interviewer"] },
          "approx_time_range": {
            "type": "string",
            "minLength": 1,
            "description": "mm:ss-mm:ss (or m:ss) span where this claim is stated. Prefer this over empty segment_ids before segmentation; empty arrays alone fail lint.",
            "examples": ["05:10-06:05"]
          },
          "segment_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_segment_ids": { "type": "array", "items": { "type": "string" } },
          "depends_on_claim_ids": { "type": "array", "items": { "type": "string" } },
          "punctuator_anchor": { "type": "boolean" },
          "act_hint": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "strategic_moat_concept": { "type": ["string", "null"] },
    "era_tags": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "era": { "type": "string" },
          "geography": { "type": "string" },
          "palette_id": { "type": ["string", "null"] }
        }
      }
    },
    "narrative_beats": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "suggested_act": { "type": "integer", "minimum": 1, "maximum": 5 },
          "tension_contribution": { "type": "number" },
          "segment_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "audience": { "type": ["string", "null"] },
    "jargon_glossary": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["term", "plain_definition"],
        "properties": {
          "term": { "type": "string" },
          "plain_definition": { "type": "string" },
          "first_segment_id": { "type": ["string", "null"] }
        }
      }
    },
    "emotional_beats": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "segment_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
