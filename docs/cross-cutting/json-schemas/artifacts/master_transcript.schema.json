{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasterTranscript",
  "type": "object",
  "required": ["schema_version", "timebase", "cues"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "timebase": { "type": "string", "const": "master" },
    "generated_at": { "type": "string" },
    "source_edl": { "type": "string" },
    "cue_count": { "type": "integer", "minimum": 0 },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms", "speaker_name", "text"],
        "properties": {
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "speaker_id": { "type": "string" },
          "speaker_name": { "type": "string" },
          "text": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["speech", "vo_pickup", "transition"]
          },
          "asset_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
