{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElevenLabsPromptsArtifact",
  "type": "object",
  "required": ["prompts"],
  "properties": {
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "elevenlabs_prompt",
          "duration_seconds",
          "negative_prompt"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "elevenlabs_prompt": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "negative_prompt": {
            "type": "string",
            "minLength": 1
          },
          "prompt_influence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "musical_intent": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
