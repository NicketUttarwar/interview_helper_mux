{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasteringPlan",
  "type": "object",
  "required": [
    "version",
    "cold_open",
    "decisions",
    "bespoke_rationale",
    "invariants",
    "generated_at",
    "narrative_mode",
    "montage_grammar",
    "plan_status",
    "pass"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "cold_open": {
      "type": "object",
      "required": [
        "kind",
        "rationale",
        "evidence_refs",
        "confidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "segment_hook",
            "vo_clone_open",
            "vo_plus_segment"
          ]
        },
        "segment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "vo_line_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "vo_voice_speaker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "cue_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "reprise_later": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clarifying_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "rationale",
          "evidence_refs",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owner_module": {
            "type": "string"
          },
          "decision": {
            "type": "object",
            "additionalProperties": true
          },
          "rationale": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "ordered_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bespoke_rationale": {
      "type": "string"
    },
    "invariants": {
      "type": "object",
      "required": [
        "never_invent_unspoken_dialogue"
      ],
      "properties": {
        "never_invent_unspoken_dialogue": {
          "type": "boolean",
          "const": true
        },
        "prefer_pickup_voice": {
          "type": "boolean"
        },
        "pickup_voice_only": {
          "type": "boolean"
        },
        "pickup_eligible_speaker_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "agenda_ref": {
      "type": "string"
    },
    "cross_critique_ref": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "narrative_mode": {
      "type": "string",
      "enum": [
        "conversational_host",
        "guide_summary",
        "documentary_bridge",
        "hook_montage",
        "sparse_source",
        "hybrid_bespoke"
      ]
    },
    "montage_grammar": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "vo_then_clip",
          "clip_then_react_vo",
          "summary_replace_setup",
          "cold_open_then_body",
          "act_preface_blocks",
          "interleaved_bridges",
          "information_package_then_block"
        ]
      }
    },
    "information_packages": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "after_segment_id",
          "before_segment_ids",
          "music",
          "vo",
          "why_package_required",
          "evidence_refs",
          "confidence"
        ],
        "properties": {
          "package_id": { "type": "string" },
          "after_segment_id": { "type": "string" },
          "before_segment_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "music": {
            "type": "object",
            "additionalProperties": true
          },
          "vo": {
            "type": "object",
            "additionalProperties": true
          },
          "new_information_claim": { "type": "string" },
          "why_package_required": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "gate_scores": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "episode_close": {
      "type": "object",
      "required": ["music", "rationale", "evidence_refs", "confidence"],
      "properties": {
        "music": {
          "type": "object",
          "required": ["required", "role"],
          "properties": {
            "required": { "type": "boolean" },
            "role": {
              "type": "string",
              "const": "theme_outro"
            },
            "placement": { "type": "string" },
            "fade_out": { "type": "string" },
            "fade_out_ms": { "type": "integer", "minimum": 0 },
            "may_underscore_last_native_tail": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "rationale": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "complete",
        "degraded",
        "forced_sparse",
        "absent_legacy"
      ]
    },
    "pass": {
      "type": "string",
      "enum": [
        "provisional",
        "confirmed"
      ]
    },
    "provisional_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirmed_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "pov": {
      "type": [
        "string",
        "null"
      ]
    },
    "listener_outcome": {
      "type": "object",
      "properties": {
        "finishability": {
          "type": "string"
        },
        "recommendability": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "degradation_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_packet_hash": {
      "type": "string"
    },
    "hybrid_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "hybrid_prefer_forbid": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
