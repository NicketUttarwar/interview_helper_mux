{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoundDesignPlanFlow1Artifact",
  "type": "object",
  "required": ["assets", "flow_plans"],
  "properties": {
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "role", "description", "duration_seconds"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "palette_id": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "reuse_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "flow_plans": {
      "type": "object",
      "required": ["flow1"],
      "properties": {
        "flow1": {
          "type": "object",
          "required": ["profile", "cues"],
          "properties": {
            "profile": { "type": "string", "const": "podcast" },
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cue_id", "asset_id", "placement"],
                "properties": {
                  "cue_id": { "type": "string", "minLength": 1 },
                  "asset_id": { "type": "string", "minLength": 1 },
                  "placement": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
