{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasterSelectionArtifact",
  "type": "object",
  "required": ["ordered_segment_ids"],
  "properties": {
    "ordered_segment_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "segment_ids"],
        "properties": {
          "title": { "type": "string" },
          "segment_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "excluded_segment_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "reason"],
        "properties": {
          "segment_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" },
    "order_content_hash": { "type": "string" },
    "order_lock": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "revision": { "type": "integer" },
        "authority": { "type": "string" },
        "ordered_segment_ids": { "type": "array", "items": { "type": "string" } },
        "order_content_hash": { "type": "string" },
        "created_by": { "type": "string" },
        "supersedes": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "order_authority": { "type": "string" },
    "optimizer_candidate_id": { "type": "string" },
    "optimizer_score": {},
    "admitted_story_segment_ids": { "type": "array", "items": { "type": "string" } },
    "considerable_segment_ids": { "type": "array", "items": { "type": "string" } },
    "media_ip_cta": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "clearly_media_ip_pitch"],
        "properties": {
          "segment_id": { "type": "string" },
          "clearly_media_ip_pitch": { "type": "boolean" },
          "mixed_with_story": { "type": "boolean" },
          "must_keep_in_clip": { "type": "boolean" },
          "cta_region": {
            "type": "string",
            "enum": ["whole", "start", "end", "middle"]
          },
          "cut_ms": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "cta_open": { "type": "boolean" },
          "open_choice": {
            "type": "string",
            "enum": ["story_child_first", "third_person_opener"]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
