{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasterSelectionArtifact",
  "type": "object",
  "required": ["ordered_segment_ids"],
  "properties": {
    "ordered_segment_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "segment_ids"],
        "properties": {
          "title": { "type": "string" },
          "segment_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "excluded_segment_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "reason"],
        "properties": {
          "segment_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
