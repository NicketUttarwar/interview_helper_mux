{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetTranscript",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "asset_id",
    "speaker_id",
    "speaker_name",
    "timebase",
    "start_ms",
    "end_ms",
    "text",
    "words"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": {
      "type": "string",
      "enum": ["speech", "vo_pickup", "transition"]
    },
    "asset_id": { "type": "string", "minLength": 1 },
    "speaker_id": { "type": "string" },
    "speaker_name": { "type": "string" },
    "timebase": {
      "type": "string",
      "enum": ["source", "asset"]
    },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 0 },
    "text": { "type": "string" },
    "source_path": { "type": ["string", "null"] },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "start_ms", "end_ms", "speaker_id"],
        "properties": {
          "text": { "type": "string" },
          "start_ms": { "type": "integer" },
          "end_ms": { "type": "integer" },
          "speaker_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
