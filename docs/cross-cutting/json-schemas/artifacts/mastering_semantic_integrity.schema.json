{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasteringSemanticIntegrity",
  "description": "Anti-fabrication findings for shape candidates (mastering/shape/semantic_integrity.json).",
  "type": "object",
  "required": ["version", "candidates", "generated_at"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "mode": { "type": "string", "enum": ["off", "advisory", "authoritative"] },
    "llm_confirm_applied": { "type": "boolean" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate_integrity" }
    },
    "clean_candidate_ids": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true,
  "$defs": {
    "candidate_integrity": {
      "type": "object",
      "required": ["candidate_id", "verdict", "findings"],
      "properties": {
        "candidate_id": { "type": "string" },
        "verdict": { "type": "string", "enum": ["pass", "pass_with_warnings", "fail"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["class_id", "severity", "detail", "source"],
      "properties": {
        "class_id": {
          "type": "string",
          "enum": [
            "quote_out_of_context",
            "causality_reversal",
            "false_reaction_adjacency",
            "fabricated_exchange",
            "vo_overstates_claim",
            "chronology_scramble",
            "orphaned_referent",
            "reprise_implies_repeat",
            "attribution_drift"
          ]
        },
        "severity": { "type": "string", "enum": ["critical", "warn"] },
        "detail": { "type": "string" },
        "source": { "type": "string", "enum": ["deterministic", "llm", "confirmed"] },
        "segment_id": { "type": ["string", "null"] },
        "related_segment_ids": { "type": "array", "items": { "type": "string" } },
        "vo_line_id": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "repair_directive": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  }
}
