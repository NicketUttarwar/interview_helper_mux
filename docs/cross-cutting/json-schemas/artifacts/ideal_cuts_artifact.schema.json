{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdealCutsArtifact",
  "type": "object",
  "required": ["cuts"],
  "properties": {
    "cuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cut_id", "talking_point_id", "start_ms", "end_ms", "priority", "rationale"],
        "properties": {
          "cut_id": { "type": "string" },
          "talking_point_id": { "type": "string" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "start_word_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional 0-based index into transcript.words for the first included word."
          },
          "end_word_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional 0-based index into transcript.words for the last included word."
          },
          "start_anchor": {
            "type": "string",
            "description": "Optional 2–6 word quote at the open hinge; preferred over free-floating start_ms."
          },
          "end_anchor": {
            "type": "string",
            "description": "Optional 2–6 word quote at the close hinge; preferred over free-floating end_ms."
          },
          "priority": {
            "type": "string",
            "enum": ["must_keep", "should_keep", "optional"]
          },
          "rationale": { "type": "string" },
          "speaker_id": { "type": "string" },
          "text_excerpt": { "type": "string" },
          "split_reason": { "type": "string" },
          "includes_speaker_volley": { "type": "boolean" }
        }
      }
    },
    "coverage_notes": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
