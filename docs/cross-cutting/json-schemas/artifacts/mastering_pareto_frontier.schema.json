{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasteringParetoFrontier",
  "description": "Non-dominated shape candidates feeding flagship synthesize (mastering/shape/pareto.json).",
  "type": "object",
  "required": ["version", "dimensions", "frontier", "generated_at"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "description": "Dimension ids compared; all treated as higher-is-better after normalization.",
      "items": { "type": "string" }
    },
    "frontier": {
      "type": "array",
      "items": { "$ref": "#/$defs/frontier_member" }
    },
    "dominated": {
      "type": "array",
      "items": { "$ref": "#/$defs/dominated_member" }
    },
    "hard_failed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "reason"],
        "properties": {
          "candidate_id": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true,
  "$defs": {
    "frontier_member": {
      "type": "object",
      "required": ["candidate_id", "scores"],
      "properties": {
        "candidate_id": { "type": "string" },
        "scores": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        },
        "best_dimensions": {
          "type": "array",
          "description": "Dimensions on which this candidate is the panel maximum.",
          "items": { "type": "string" }
        },
        "tradeoff_note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "dominated_member": {
      "type": "object",
      "required": ["candidate_id", "dominated_by"],
      "properties": {
        "candidate_id": { "type": "string" },
        "dominated_by": { "type": "array", "items": { "type": "string" } },
        "scores": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": false
    }
  }
}
