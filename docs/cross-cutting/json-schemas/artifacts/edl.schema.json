{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow1Edl",
  "type": "object",
  "required": [
    "version",
    "ordered_segment_ids",
    "clips",
    "timeline_duration_ms"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "ordered_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "segment_id",
              "source_start_ms",
              "source_end_ms",
              "timeline_start_ms",
              "duration_ms"
            ],
            "properties": {
              "type": {
                "const": "speech"
              },
              "segment_id": {
                "type": "string"
              },
              "source_start_ms": {
                "type": "integer"
              },
              "source_end_ms": {
                "type": "integer"
              },
              "timeline_start_ms": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "integer"
              },
              "mix_overlap_ms": {
                "description": "Realized mix crossfade into this clip. timeline_start_ms already subtracts it.",
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "line_id",
              "targets_segment_id",
              "placement",
              "timeline_start_ms",
              "duration_ms"
            ],
            "properties": {
              "type": {
                "const": "vo_pickup"
              },
              "line_id": {
                "type": "string"
              },
              "targets_segment_id": {
                "type": "string"
              },
              "placement": {
                "enum": [
                  "before",
                  "after"
                ],
                "type": "string"
              },
              "gap_type": {
                "type": "string"
              },
              "script_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "context_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_path": {
                "description": "Relative audio path. Writers must omit this key when the file is missing — never persist a ghost path.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "timeline_start_ms": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "integer"
              },
              "mix_overlap_ms": {
                "description": "Realized mix crossfade into this clip. timeline_start_ms already subtracts it.",
                "type": "integer",
                "minimum": 0
              },
              "voice_speaker_id": {
                "type": "string"
              },
              "clone_adjacency_exempt": {
                "type": "boolean"
              },
              "line_category": {
                "type": "string"
              },
              "episode_orientation": {
                "type": "boolean"
              },
              "allow_music_bed_overlap": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "after_segment_id",
              "before_segment_id",
              "timeline_start_ms"
            ],
            "properties": {
              "type": {
                "const": "transition"
              },
              "after_segment_id": {
                "type": "string"
              },
              "before_segment_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "transition_type": {
                "type": "string"
              },
              "script_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "duration_ms": {
                "type": "integer"
              },
              "timeline_start_ms": {
                "type": "integer"
              },
              "source_path": {
                "description": "Relative transition WAV. Omit when the file is missing — never persist a ghost path.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "mix_overlap_ms": {
                "description": "Realized mix crossfade into this clip. timeline_start_ms already subtracts it.",
                "type": "integer",
                "minimum": 0
              },
              "voice_speaker_id": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "event_id",
              "segment_id",
              "timeline_start_ms",
              "duration_ms"
            ],
            "properties": {
              "type": {
                "const": "disfluency"
              },
              "event_id": {
                "type": "string"
              },
              "segment_id": {
                "type": "string"
              },
              "source_path": {
                "description": "Relative audio path. Omit when the file is missing — never persist a ghost path.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_start_ms": {
                "type": "integer"
              },
              "source_end_ms": {
                "type": "integer"
              },
              "timeline_start_ms": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timeline_start_ms",
              "duration_ms"
            ],
            "properties": {
              "type": {
                "const": "silence"
              },
              "air_kind": {
                "type": "string"
              },
              "timeline_start_ms": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "integer"
              },
              "mix_overlap_ms": {
                "description": "Realized mix crossfade into this clip. timeline_start_ms already subtracts it.",
                "type": "integer",
                "minimum": 0
              },
              "preserve_planned_music": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "gap_placements": {
      "type": "array"
    },
    "timeline_duration_ms": {
      "type": "integer"
    },
    "silence_clip_count": {
      "type": "integer"
    },
    "vo_pickup_clip_count": {
      "type": "integer"
    },
    "transition_clip_count": {
      "type": "integer"
    },
    "gap_report_line_count": {
      "type": "integer"
    },
    "disfluency_clip_count": {
      "type": "integer"
    },
    "disfluency_restore_enabled": {
      "type": "boolean"
    },
    "warnings": {
      "type": "object"
    },
    "mux_scope": {
      "type": "string"
    },
    "order_content_hash": {
      "type": "string"
    },
    "order_lock": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "revision": { "type": "integer" },
        "authority": { "type": "string" },
        "ordered_segment_ids": { "type": "array", "items": { "type": "string" } },
        "order_content_hash": { "type": "string" },
        "created_by": { "type": "string" },
        "supersedes": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
