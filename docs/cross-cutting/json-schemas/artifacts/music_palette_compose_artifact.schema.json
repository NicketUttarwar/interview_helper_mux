{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MusicPaletteComposeArtifact",
  "type": "object",
  "required": ["cues"],
  "properties": {
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "placement"],
        "properties": {
          "cue_id": { "type": "string" },
          "asset_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "placement": {
            "type": "string",
            "enum": ["before_segment", "after_segment", "under_segment"]
          },
          "before_segment_id": { "type": "string" },
          "after_segment_id": { "type": "string" },
          "under_segment_id": { "type": "string" },
          "segment_id": { "type": "string" },
          "level_db": { "type": "number" },
          "crossfade_ms": { "type": "number" }
        }
      }
    },
    "notes": { "type": "string" },
    "rationale": { "type": "string" }
  }
}
