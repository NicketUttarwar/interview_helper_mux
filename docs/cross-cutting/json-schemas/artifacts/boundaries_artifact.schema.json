{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundariesArtifact",
  "type": "object",
  "required": ["boundaries"],
  "properties": {
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "start_ms", "end_ms", "proposed_split_reason"],
        "properties": {
          "segment_id": { "type": "string" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "speaker_id": { "type": "string" },
          "proposed_split_reason": { "type": "string" },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Combined row confidence (min of start/end edge overall)."
          },
          "edge_grade": {
            "type": "string",
            "enum": ["high", "medium", "low", "reject"]
          },
          "start_edge": { "$ref": "#/$defs/edgeEvidence" },
          "end_edge": { "$ref": "#/$defs/edgeEvidence" },
          "overlong_unsplit": { "type": "boolean" },
          "airable": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "edgeEvidence": {
      "type": "object",
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "grade": {
          "type": "string",
          "enum": ["high", "medium", "low", "reject"]
        },
        "selected_ms": { "type": "integer", "minimum": 0 },
        "candidate_ms": { "type": "integer", "minimum": 0 },
        "signals": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repaired": { "type": "boolean" },
        "repair_action": { "type": "string" },
        "original_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
