{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundariesArtifact",
  "type": "object",
  "required": ["boundaries"],
  "properties": {
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "start_ms", "end_ms", "proposed_split_reason"],
        "properties": {
          "segment_id": { "type": "string" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "speaker_id": { "type": "string" },
          "proposed_split_reason": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
