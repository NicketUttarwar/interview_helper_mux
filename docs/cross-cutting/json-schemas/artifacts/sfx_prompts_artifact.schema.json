{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SfxPromptsArtifact",
  "type": "object",
  "required": ["prompts"],
  "properties": {
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "sfx_prompt",
          "duration_seconds",
          "negative_prompt"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "sfx_prompt": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "negative_prompt": {
            "type": "string",
            "minLength": 1
          },
          "prompt_influence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "role": {
            "type": "string"
          },
          "mmaudio_variant": {
            "type": "string",
            "enum": [
              "small_16k",
              "small_44k",
              "medium_44k",
              "large_44k",
              "large_44k_v2"
            ]
          },
          "cfg_strength": {
            "type": "number",
            "minimum": 2.0,
            "maximum": 8.0
          },
          "num_steps": {
            "type": "integer",
            "minimum": 10,
            "maximum": 50
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "regression_notes": {
            "type": "string"
          },
          "musical_intent": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
