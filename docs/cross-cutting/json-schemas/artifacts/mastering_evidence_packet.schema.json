{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasteringEvidencePacket",
  "description": "Bounded, provenanced context for one LLM consumer (mastering/evidence_packets/{consumer_id}.json).",
  "type": "object",
  "required": ["version", "consumer_id", "budget", "items", "generated_at"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "consumer_id": {
      "type": "string",
      "description": "Field id, shape level id, critic id, or polish audit id."
    },
    "consumer_kind": {
      "type": "string",
      "enum": ["research_field", "shape_level", "capability_module", "critic", "arbiter", "polish_audit", "other"]
    },
    "budget": { "$ref": "#/$defs/budget" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_item" }
    },
    "omitted": {
      "type": "array",
      "description": "Items dropped to stay inside budget, retained as pointers.",
      "items": { "$ref": "#/$defs/omitted_item" }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true,
  "$defs": {
    "budget": {
      "type": "object",
      "required": ["max_tokens", "used_tokens"],
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 0 },
        "used_tokens": { "type": "integer", "minimum": 0 },
        "truncation_policy": {
          "type": "string",
          "enum": ["drop_lowest_salience", "summarize", "pointer_only"]
        },
        "exceeded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence_item": {
      "type": "object",
      "required": ["ref", "kind", "salience"],
      "properties": {
        "ref": {
          "type": "string",
          "description": "Run-relative artifact path, optionally with a #fragment pointer."
        },
        "kind": {
          "type": "string",
          "enum": ["artifact", "segment", "transcript_window", "asset", "metric", "operator_decision"]
        },
        "sha256": { "type": ["string", "null"] },
        "segment_ids": { "type": "array", "items": { "type": "string" } },
        "start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "end_ms": { "type": ["integer", "null"], "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "salience": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness": {
          "type": "string",
          "enum": ["current", "stale", "unknown"]
        },
        "inline": {
          "description": "Materialized content when small enough for the budget; otherwise null and the consumer must retrieve via ref.",
          "type": ["string", "object", "array", "null"]
        },
        "tokens": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "omitted_item": {
      "type": "object",
      "required": ["ref", "reason"],
      "properties": {
        "ref": { "type": "string" },
        "reason": { "type": "string" },
        "salience": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
