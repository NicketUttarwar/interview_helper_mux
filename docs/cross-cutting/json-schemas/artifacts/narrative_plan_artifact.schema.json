{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NarrativePlanArtifact",
  "type": "object",
  "required": ["arc_summary", "chapters", "ordering_constraints"],
  "properties": {
    "arc_summary": { "type": "string", "minLength": 1 },
    "chapters": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["chapter_id", "title", "suggested_open_segment_id"],
        "properties": {
          "chapter_id": { "type": "string" },
          "title": { "type": "string" },
          "topic_tags": { "type": "array", "items": { "type": "string" } },
          "suggested_open_segment_id": { "type": "string" },
          "segment_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "act_number": { "type": "integer", "minimum": 1, "maximum": 5 },
          "act_title": { "type": ["string", "null"] },
          "tension_level": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "is_moat_chapter": { "type": ["boolean", "null"] }
        }
      }
    },
    "strategic_moat_concept": { "type": ["string", "null"] },
    "five_act_coverage": {
      "type": "object",
      "properties": {
        "act_1": { "type": "integer" },
        "act_2": { "type": "integer" },
        "act_3": { "type": "integer" },
        "act_4": { "type": "integer" },
        "act_5": { "type": "integer" }
      }
    },
    "ordering_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["before_segment_id", "after_segment_id", "reason"],
        "properties": {
          "before_segment_id": { "type": "string" },
          "after_segment_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "pacing_notes": { "type": "string" }
  }
}
