{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SonicContext",
  "type": "object",
  "required": [
    "version",
    "scenario",
    "sonic_identity_seed",
    "tag_registry",
    "cue_opportunities",
    "mix_policy",
    "avoid_hard",
    "segment_flags"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "sonic_context_hash": {
      "type": "string",
      "description": "Stable hash of inputs used to build this artifact (invalidation / reuse)."
    },
    "built_from": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relative artifact paths consumed when building sonic_context."
    },
    "sparse_mode": {
      "type": "boolean",
      "description": "When true, tag_registry may be empty (single-topic or operator dry-run)."
    },
    "scenario": {
      "type": "object",
      "required": ["format_class", "tone_class", "atlas_bucket", "sound_posture"],
      "properties": {
        "format_class": { "type": "string" },
        "tone_class": { "type": "string" },
        "atlas_bucket": {
          "type": "string",
          "enum": [
            "one_on_one",
            "panel",
            "fireside",
            "technical_deep_dive",
            "media_profile",
            "debate",
            "noisy_room",
            "dense_jargon",
            "trauma_adjacent"
          ]
        },
        "sound_posture": {
          "type": "object",
          "required": ["bed_density", "stinger_cap_per_minute"],
          "properties": {
            "bed_density": {
              "type": "string",
              "enum": ["none", "minimal", "sparse", "moderate"]
            },
            "stinger_cap_per_minute": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "sonic_identity_seed": {
      "type": "object",
      "required": ["primary_mood", "density_hint", "room_character"],
      "properties": {
        "primary_mood": { "type": "string" },
        "density_hint": { "type": "string" },
        "room_character": { "type": "string" }
      },
      "additionalProperties": true
    },
    "tag_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag_id", "kind", "keywords", "provenance"],
        "properties": {
          "tag_id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["topic", "entity", "emotional", "theme", "acoustic"]
          },
          "keywords": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "segment_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "emotional_valence": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "provenance": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    },
    "cue_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "confidence", "provenance"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "chapter_boundary",
              "emotional_beat",
              "vo_bridge",
              "montage_transition",
              "laughter_window",
              "tension_peak",
              "cold_open",
              "outro"
            ]
          },
          "segment_id": { "type": "string" },
          "from_clip_rank": { "type": "integer", "minimum": 1 },
          "to_clip_rank": { "type": "integer", "minimum": 1 },
          "beat": { "type": "string" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "provenance": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    },
    "mix_policy": {
      "type": "object",
      "required": [
        "underscore_policy",
        "adaptive_max_assets_flow1",
        "adaptive_max_assets_flow2",
        "duration_bands_by_role"
      ],
      "properties": {
        "underscore_policy": {
          "type": "string",
          "enum": ["normal", "sparse", "sparse_or_skip", "skip"]
        },
        "adaptive_max_assets_flow1": { "type": "integer", "minimum": 0 },
        "adaptive_max_assets_flow2": { "type": "integer", "minimum": 0 },
        "stinger_cap_per_minute": { "type": "number", "minimum": 0 },
        "duration_bands_by_role": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0.1 }
          }
        }
      },
      "additionalProperties": true
    },
    "avoid_hard": {
      "type": "array",
      "items": { "type": "string" }
    },
    "segment_flags": {
      "type": "object",
      "properties": {
        "overlap_high": { "type": "array", "items": { "type": "string" } },
        "trauma_adjacent": { "type": "array", "items": { "type": "string" } },
        "jargon_dense": { "type": "array", "items": { "type": "string" } },
        "disfluency_restore": { "type": "array", "items": { "type": "string" } },
        "comprehension_risk": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "value_features_summary": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
