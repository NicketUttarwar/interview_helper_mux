{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageContract",
  "type": "object",
  "required": ["stage_id", "tier"],
  "properties": {
    "stage_id": { "type": "string" },
    "tier": {
      "type": "string",
      "enum": ["llm_full", "deterministic", "gate", "process", "meta"]
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "phases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inputs": {
      "type": "object",
      "properties": {
        "hard": { "type": "array" },
        "soft": { "type": "array" }
      }
    },
    "outputs": { "type": "array" },
    "sufficiency": { "type": "array" },
    "propagation": {
      "type": "object",
      "properties": {
        "invalidates_stages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "consumers": { "type": "array", "items": { "type": "string" } },
    "edges": {
      "type": "object",
      "description": "Affirmative completeness of this contract's dependency edges. Precision invalidation (plan §5.4) is subtractive, so an absent or empty edge list means UNKNOWN and keeps the stage in the blanket invalidation set. These markers are the only way to say otherwise; `terminal` is the only spelling of an affirmatively empty consumer set.",
      "properties": {
        "inputs": {
          "type": "string",
          "enum": ["complete"],
          "description": "`inputs` enumerates every artifact this stage reads."
        },
        "consumers": {
          "type": "string",
          "enum": ["complete", "terminal"],
          "description": "`complete`: `consumers` lists every stage that reads this stage's outputs. `terminal`: nothing downstream reads them at all."
        }
      },
      "additionalProperties": false
    },
    "remediation": {
      "type": "object",
      "properties": {
        "strategies": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": true
}
