# Deliberately NOT `* text=auto`: most of this repo is already committed with
# CRLF, so a repo-wide eol rule would renormalize ~2.4k files and bury real
# work. Scope line-ending rules to the paths where mixed endings actually cause
# churn, and keep binary assets byte-exact.

# The committed GUI bundle is generated by `vite build`, which always writes
# LF. Pinning it to LF means a rebuild on any platform produces a byte-identical
# tree instead of 13 files of line-ending-only diffs in every PR.
src/interview_mux/web/static/** text eol=lf

# Shell scripts must be LF: CRLF makes the shebang fail on macOS and Linux
# with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# Python and Markdown are LF. 1275 of the 1308 tracked .py files were already
# LF; the 33 that were not are precisely the ones edited from Windows, where
# pathlib's write_text translates 
 to 
 on the way out. Each of those
# showed up as a whole-file rewrite, which buries a 20-line fix in a 2800-line
# diff and makes a PR unreviewable. Pinning the extension stops that at the
# source rather than relying on remembering to normalise by hand.
*.py text eol=lf
*.md text eol=lf

# Binary assets: never touch these bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.flac binary
*.safetensors binary
*.ckpt binary
*.pt binary
*.bin binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary

# Avoid automatic merges of Terraform state (resolve conflicts intentionally).
terraform/state/terraform.tfstate merge=binary
