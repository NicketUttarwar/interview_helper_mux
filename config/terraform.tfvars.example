# Copy to terraform.tfvars (gitignored):
#   cp config/terraform.tfvars.example config/terraform.tfvars
#
# Keep s3_bucket_name identical to config/app.defaults.json → podcast.s3_bucket
# (committed app config is the runtime source of truth for the bucket name).
# Terraform state remains the infra inventory; secrets.env holds only AWS creds
# + derived CloudFront ID / feed base URL.
#
# Migrating the bucket name updates the CloudFront origin but keeps the same
# distribution domain (feed URL stays stable).
#
# Same-bucket CloudFront URL rotate (deletes the old public RSS URL):
#   ./scripts/tf-rotate-cloudfront-url.sh
# New bucket + new CloudFront (archives the old pair, leaves it live):
#   ./scripts/tf-podcast-rss-origin.sh

project_name   = "the_war_room_001"
show_title     = "The War Room"
environment    = "prod"
s3_bucket_name = "the-war-room-rss-001"

cloudfront_price_class = "PriceClass_200"
# common_tags = { Owner = "you" }
