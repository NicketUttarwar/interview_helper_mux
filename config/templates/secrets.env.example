# =============================================================================
# Copy this entire file to:  config/secrets/secrets.env
# Then fill in keys. The whole config/secrets/ directory is gitignored.
# Python integrations read only this file tree (see config/README.md); nothing
# here is applied to the process environment.
# =============================================================================

# --- Run targets (edit per machine; overrides config/app.defaults.json) ---
INPUT_AUDIO_PATH=ASSETS/input/interview.wav

# --- OpenAI (LLM ranking, automation, prompts) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Transcription / speech-to-text model id when you add OpenAI audio adapters (SDK uses same key).
OPENAI_SPEECH_MODEL=whisper-1
# OPENAI_ORG_ID=

# Local MLX model id is NOT a secret. Bootstrap (scripts/bootstrap_venv.sh) runs
# llmfit on Apple Silicon, writes ASSETS/local_llm/selection.json, downloads
# weights (reuses on later bootstraps), and calibrates capability_manifest.json.
# Then use ./scripts/run.sh as often as you like — no LOCAL_LLM_MODEL_ID needed.

# Local MLX stacks (bootstrap via scripts/bootstrap_venv.sh — not secrets):
#   ASSETS/local_speech/venv  — mlx-audio STT + S2S (Apple Silicon)
#   ASSETS/local_llm/venv     — mlx-lm volley framer (Apple Silicon, fail-open)
#   ASSETS/local_image/venv   — MLX T2I episode covers (Apple Silicon, fail-open)
# Selection manifests: ASSETS/local_speech/selection.json, ASSETS/local_llm/selection.json,
#   ASSETS/local_image/selection.json (includes prompt_max_tokens)

# --- Podcast RSS publish ---
# Non-secret values (bucket, region, project, show meta, S3 layout) live in:
#   config/app.defaults.json → podcast { s3_bucket, aws_region, project_name, … }
# Terraform: ./scripts/tf-init.sh && ./scripts/tf-plan.sh && ./scripts/tf-apply.sh
# Seed:      python scripts/seed_podcast_origin.py
#
# --- AWS (podcast RSS only — Terraform + boto3; never require AWS CLI / aws login) ---
# Put long-lived keys or AWS_PROFILE here. Infra: ./scripts/tf-init.sh → tf-plan → tf-apply
# (updates terraform/state/terraform.tfstate and syncs PODCAST_* below).
# App publish/seed/invalidate: boto3 reads these env keys from secrets.env.
#
# This file holds credentials + AWS-derived IDs only (tf-apply syncs CF/feed):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_DEFAULT_REGION=us-east-1
# PODCAST_CLOUDFRONT_DISTRIBUTION_ID=
# PODCAST_FEED_BASE_URL=https://xxxxx.cloudfront.net
# Optional override only — prefer podcast.s3_bucket in app.defaults.json:
# PODCAST_S3_BUCKET=

# --- Cursor (CURSOR_EXECUTE agent runs — https://cursor.com/dashboard/integrations) ---
# User keys are often cursor_... or crsr_...
CURSOR_API_KEY=

# --- Hugging Face Hub (free account token is enough for public models) ---
# Raises Hub rate limits / avoids "unauthenticated requests" warnings during
# CLAP embed + local model downloads. Not required for a paid HF plan.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# --- Optional: other best-of-breed APIs (uncomment and fill as you adopt them) ---

# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=

# Speech / transcription SaaS
# ASSEMBLYAI_API_KEY=
# DEEPGRAM_API_KEY=
# REV_AI_ACCESS_TOKEN=

# Media / infra (aligns with “mux” product name; use if you wire Mux Video)
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# Payments / gating (if you add a billing surface)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Observability
# DATADOG_API_KEY=
# SENTRY_DSN=

# Web search / research tools (orchestrator plugins)
# TAVILY_API_KEY=
# BRAVE_API_KEY=
