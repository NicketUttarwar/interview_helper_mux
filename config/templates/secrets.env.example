# =============================================================================
# Copy this entire file to:  config/secrets/secrets.env
# Then fill in keys. The whole config/secrets/ directory is gitignored.
# Python integrations read only this file tree (see config/README.md); nothing
# here is applied to the process environment.
# =============================================================================

# --- OpenAI (LLM ranking, automation, prompts) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Transcription / speech-to-text model id when you add OpenAI audio adapters (SDK uses same key).
OPENAI_SPEECH_MODEL=whisper-1
# OPENAI_ORG_ID=

# --- AWS (Transcribe, S3, Lambda, Bedrock, etc.) ---
# Use the same region you want boto3 / CLI calls to default to.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Some tools read AWS_REGION; set to the same region if you use them.
# AWS_REGION=us-east-1
# Optional named profile instead of keys above (uncomment and use one approach):
# AWS_PROFILE=

# --- ElevenLabs (TTS / voice clone — see docs/execution/speech-to-speech-and-trained-remix-models.md) ---
ELEVENLABS_API_KEY=

# --- Optional: other best-of-breed APIs (uncomment and fill as you adopt them) ---

# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=

# Speech / transcription SaaS
# ASSEMBLYAI_API_KEY=
# DEEPGRAM_API_KEY=
# REV_AI_ACCESS_TOKEN=

# Media / infra (aligns with “mux” product name; use if you wire Mux Video)
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# Payments / gating (if you add a billing surface)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Observability
# DATADOG_API_KEY=
# SENTRY_DSN=

# Web search / research tools (orchestrator plugins)
# TAVILY_API_KEY=
# BRAVE_API_KEY=
