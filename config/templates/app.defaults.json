{
  "_comment_paths": "ASSETS root, executions, sample_rate, flow LUFS targets",
  "assets_root": "ASSETS",
  "input_audio_path": "ASSETS/input/interview.wav",
  "data_root": "data",
  "executions_root": "ASSETS/executions",
  "sample_rate": 48000,
  "flow1_target_lufs": -16.0,
  "autopilot_enabled": false,
  "operator": { "autopilot_enabled": false },
  "flow2_target_lufs": -14.0,
  "show_description_min_words": 150,
  "show_description_max_words": 250,
  "show_description_target_words": 200,
  "_comment_models": "OpenAI tier routing per stage",
  "models": {
    "tiers": {
      "economy": "gpt-4o-mini",
      "standard": "gpt-4o",
      "flagship": "o3"
    },
    "stages": {
      "speaker_roles": { "tier": "economy" },
      "content_context": { "tier": "economy" },
      "boundary_detection": { "tier": "standard" },
      "segment_classification": { "tier": "standard" },
      "missing_framing": { "tier": "flagship" },
      "optimal_questions": { "tier": "flagship" },
      "topic_coverage_audit": { "tier": "flagship" },
      "narrative_arc_plan": { "tier": "flagship" },
      "full_master_ranking": { "tier": "flagship" },
      "edl_narrative_audit": { "tier": "flagship" },
      "transitions": { "tier": "economy" },
      "podcast_sfx_brief": { "tier": "economy" },
      "sfx_brief": { "tier": "economy" }
    }
  },
  "_comment_sound_design": "SDP asset caps and post-generation placement QA",
  "sound_design": {
    "enabled": true,
    "allow_diegetic_ambient": false,
    "post_listen_gate_mode": "warn",
    "max_assets": 6,
    "max_assets_flow1": 6,
    "max_assets_flow2": 4,
    "use_adaptive_caps": true,
    "placement_qa_enabled": true,
    "block_mix_on_mmaudio_qa_fail": false,
    "one_regen_on_fail": true,
    "first_try_allow_placeholder_mix": true
  },
  "_comment_soundscape": "Closed-loop soundscape policy (BUILD-SS-01…06)",
  "soundscape": {
    "enabled": true,
    "strict_slots": true,
    "fail_closed": false,
    "fail_closed_default": false,
    "remediation": {
      "max_remux_cycles": 1,
      "max_regen_per_asset": 1
    }
  },
  "_comment_mix_engine": "crossfade_ms_* and preclean acknowledgment for step-through runner",
  "mix": {
    "crossfade_ms_flow1": 100,
    "crossfade_ms_flow2": 120,
    "crossfade_ms_assembly_preview": 80,
    "require_preclean_acknowledgment": true,
    "adaptive_crossfade": true,
    "adaptive_level_from_sap": true,
    "scenario_overlay_rules": true,
    "word_boundary_cuts": true,
    "word_boundary_margin_ms": 50,
    "word_boundary_max_shift_ms": 400,
    "normalize_vo_pickup": true,
    "completeness_gate": {
      "enabled": true,
      "mode": "warn"
    },
    "intelligibility_qc": {
      "enabled": true,
      "silent_speech_mix_ceiling_dbfs": -32
    }
  },
  "_comment_quality_gates": "G1.5, narrative/show QC strict, nle_edits.strict — production values applied in gap-closure GC-F3",
  "g1_5_require_prompt_approval": true,
  "narrative_qc": {
    "strict": true
  },
  "edl_qc": {
    "strict": true
  },
  "edl_narrative_qc": {
    "strict": true
  },
  "show_notes_qc": {
    "strict": true
  },
  "nle_edits": {
    "strict": true
  },
  "_comment_value_analysis": "Deterministic extract flags — auto-extract after content_context; no SSL",
  "value_analysis": {
    "enabled": true,
    "spike_scoring": true,
    "transcript_features": true,
    "audio_features": true,
    "auto_extract_after_content_context": true,
    "orc03_enabled": true
  },
  "_comment_coherence": "H-ORC-03 long-run coherence — 30m gate, composite drift/contradiction/callback",
  "coherence": {
    "enabled": true,
    "min_duration_ms": 1800000,
    "max_investigations_per_run": 8,
    "max_risks_in_memory": 20,
    "topic_drift_threshold": 0.55,
    "claim_contradiction_threshold": 0.72,
    "missing_callback_threshold": 0.60,
    "require_acoustic_novelty": true,
    "novelty_min_delta": 0.18,
    "theme_alignment_min": 0.35,
    "blocking_claim_contradiction": true,
    "replace_stub_topic_shift_hints": true
  },
  "_comment_interview_spine": "H-ORC-01 time-aligned local comprehension index (not LLM fine-tune)",
  "interview_spine": {
    "enabled": true,
    "clap_enabled": true,
    "prosody_enabled": true,
    "window_sec_default": 10,
    "window_sec_dense": 6,
    "window_sec_calm": 12,
    "hop_sec": 5,
    "boundary_fusion_min_sources": 1,
    "clap_model_id": "laion/clap-htsat-fused",
    "clap_timeout_sec": 120,
    "ssl_enabled": false,
    "flow2_quotability_enabled": false
  },
  "_comment_audio_preclean": "DeepFilterNet primary; ffmpeg denoise when local stack unavailable",
  "audio_preclean": {
    "provider": "deepfilternet",
    "local_fallback_enabled": true,
    "chunk_max_bytes": 52428800
  },
  "_comment_local_runtimes": "Isolated venv paths under ASSETS/ (gitignored)",
  "local_runtimes": {
    "mlx": { "venv_dir": "ASSETS/local_llm/venv", "enabled": true },
    "deepfilter": { "venv_dir": "ASSETS/local_deepfilter/venv", "enabled": true },
    "mmaudio": { "venv_dir": "ASSETS/local_mmaudio/venv", "enabled": true }
  },
  "_comment_deepfilter": "Local DeepFilterNet noise reduction",
  "deepfilter": {
    "repo_dir": "ASSETS/local_deepfilter/DeepFilterNet",
    "model": "DeepFilterNet3",
    "postfilter": false,
    "compensate_delay": true,
    "request_timeout_sec": 600
  },
  "_comment_mmaudio": "Local MMAudio text-to-audio",
  "mmaudio": {
    "repo_dir": "ASSETS/local_mmaudio/MMAudio",
    "model_id": "large_44k_v2",
    "device": "auto",
    "request_timeout_sec": 900,
    "default_duration_sec": 8.0,
    "min_duration_sec": 3.0,
    "max_duration_sec": 8.0,
    "duration_bands_by_role": {
      "ambient_bed": [5.0, 8.0],
      "chapter_stinger": [1.0, 2.5],
      "transition_stinger": [0.8, 2.0],
      "cold_open": [2.0, 6.0],
      "vo_bridge": [2.0, 6.0],
      "accent_foley": [1.0, 4.0]
    },
    "theme_fit_threshold": 0.6,
    "silence_rms_threshold": 0.001,
    "semantic_qa_enabled": true,
    "semantic_qa_threshold": 0.18,
    "semantic_qa_fail_on_low": false,
    "semantic_qa_model_id": "laion/clap-htsat-fused",
    "semantic_qa_timeout_sec": 120,
    "plan_hash_skip_enabled": true,
    "cfg_strength_default": 4.5,
    "cfg_strength_by_role": {
      "ambient_bed": 3.8,
      "chapter_stinger": 4.8,
      "transition_stinger": 4.6,
      "cold_open": 5.0,
      "vo_bridge": 4.2,
      "accent_foley": 4.5
    },
    "num_steps": 25,
    "seed_strategy": "asset_id_hash",
    "fixed_seed": 42,
    "legacy_influence_prose": false,
    "auto_refine_enabled": true,
    "auto_refine_max_attempts_per_asset": 2,
    "auto_refine_on_qa_fail": true,
    "auto_refine_on_listen_fail": true,
    "auto_refine_on_trauma": true
  },
  "_comment_web": "GUI server port",
  "web_port": 8765,
  "_comment_local_llm": "On-device MLX volley framing before OpenAI; enabled by default on macOS bootstrap",
  "local_llm": {
    "enabled": true,
    "model_id": "mlx-community/Llama-3.2-3B-Instruct-4bit",
    "models_dir": "ASSETS/local_llm/models",
    "max_volley_turns": 2,
    "max_tokens": 768,
    "escalate_on_parse_error": true,
    "min_confidence": 0.6,
    "skip_openai_primary_when_local_satisfied": false,
    "apply_to_specialists": true,
    "apply_to_shards": true,
    "apply_to_collate": true,
    "capability": {
      "enabled": true,
      "max_local_steps": 3,
      "max_local_retries_per_cap": 0,
      "planner_fanout_k": 3,
      "max_enabled_caps": 4,
      "lx03_min_verify_rate": 0.85,
      "lx04_min_agreement": 0.95,
      "lx05_min_verify_rate": 0.85,
      "allowlist": []
    }
  },
  "_comment_analysis": "Volley caps, thresholds, orchestration; specialists run on mapped stages when enabled",
  "analysis": {
    "max_iterations_per_stage": 3,
    "max_queue_drains_per_stage": 5,
    "max_volley_retries": 2,
    "specialists": {
      "enabled": true,
      "comprehension_risk_threshold": 0.7
    },
    "prompt_examples": {
      "enabled": true,
      "mode": "full"
    },
    "context": {
      "transcript_excerpt_chars": 12000,
      "transcript_full_chars": 36000,
      "segment_text_max_chars": 400,
      "max_segments_in_context": 60,
      "max_segments_in_gap_pass": 35,
      "max_gap_evaluations": 50,
      "max_stage_data_chars": 32000,
      "interviewer_sample_lines": 8
    },
    "prompt_thresholds": {
      "pause_split_ms": 700,
      "short_question_max_words": 12,
      "interviewer_question_max_words": 60,
      "interviewer_setup_max_words": 20,
      "highlight_setup_max_sec": 8,
      "max_chapters": 8,
      "max_highlight_clips": 5
    },
    "delivery_brief": {
      "enabled": true,
      "ideal_fraction_of_source": 0.85,
      "min_duration_sec": 600,
      "max_duration_sec": 7200,
      "question_budget_max": 6,
      "enforce_duration": false
    },
    "flow_hardening": {
      "enabled": true,
      "strict_critical_stages": true,
      "preflight_enabled": true,
      "cross_validate_enabled": true,
      "max_primary_attempts_per_stage": 4,
      "max_arbiter_rejects_per_stage": 3,
      "max_investigation_reruns_per_kind": 2,
      "stuck_signature_threshold": 2,
      "spend_block_stages": [
        "sfx_prompt_craft",
        "mmaudio_sfx",
        "mix",
      ],
      "block_mix_without_sfx_when_enabled": true
    }
  },
  "structure": {
    "enabled": true,
    "strict_slots": false,
    "max_dynamic_slots": 24,
    "hook_reel_enabled": true,
    "require_payoff": false,
    "require_outro": false
  },
  "_comment_mastering": "Mastering Process + quality hardening — full defaults in config/app.defaults.json",
  "mastering": {
    "prompt_edit": { "allow_global_promotion": false, "require_operator_approval": true },
    "research": { "routing": { "mode": "advisory", "default_disposition": "required", "max_deep_fields": 12 } },
    "quality_hardening": {
      "enabled": true,
      "context": { "mode": "advisory", "default_max_tokens": 24000 },
      "diversity": { "mode": "advisory", "min_pairwise_distance": 0.35 },
      "feasibility": { "mode": "advisory" },
      "semantic_integrity": { "mode": "advisory" },
      "voice_clone": { "mode": "advisory" },
      "rubric": { "mode": "advisory" },
      "auditions": { "mode": "advisory", "max_auditions": 3 },
      "critics": { "mode": "advisory" },
      "pareto": { "mode": "advisory" },
      "polish": { "mode": "advisory", "max_remux_rounds": 2 }
    }
  }
}
