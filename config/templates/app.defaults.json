{
  "_comment_paths": "ASSETS root, executions, sample_rate, flow LUFS targets",
  "assets_root": "ASSETS",
  "input_audio_path": "ASSETS/input/interview.wav",
  "data_root": "data",
  "executions_root": "ASSETS/executions",
  "sample_rate": 48000,
  "flow1_target_lufs": -16.0,
  "flow2_target_lufs": -14.0,
  "show_description_min_words": 150,
  "show_description_max_words": 250,
  "show_description_target_words": 200,
  "_comment_models": "OpenAI tier routing per stage",
  "models": {
    "tiers": {
      "economy": "gpt-4o-mini",
      "standard": "gpt-4o",
      "flagship": "o3"
    },
    "stages": {
      "speaker_roles": { "tier": "economy" },
      "content_context": { "tier": "economy" },
      "boundary_detection": { "tier": "standard" },
      "segment_classification": { "tier": "standard" },
      "missing_framing": { "tier": "flagship" },
      "optimal_questions": { "tier": "flagship" },
      "topic_coverage_audit": { "tier": "flagship" },
      "narrative_arc_plan": { "tier": "flagship" },
      "full_master_ranking": { "tier": "flagship" },
      "edl_narrative_audit": { "tier": "flagship" },
      "highlight_selection": { "tier": "flagship" },
      "podcast_show_description": { "tier": "flagship" },
      "transitions": { "tier": "economy" },
      "podcast_sfx_brief": { "tier": "economy" },
      "sfx_brief": { "tier": "economy" }
    }
  },
  "_comment_mix_engine": "crossfade_ms_* and preclean acknowledgment for step-through runner",
  "mix": {
    "crossfade_ms_flow1": 100,
    "crossfade_ms_flow2": 120,
    "crossfade_ms_assembly_preview": 80,
    "require_preclean_acknowledgment": true,
    "intelligibility_qc": {
      "enabled": true,
      "silent_speech_mix_ceiling_dbfs": -32
    }
  },
  "_comment_quality_gates": "G1.5, narrative/show QC strict, nle_edits.strict — production values applied in gap-closure GC-F3",
  "g1_5_require_prompt_approval": true,
  "narrative_qc": {
    "strict": true
  },
  "edl_qc": {
    "strict": true
  },
  "edl_narrative_qc": {
    "strict": true
  },
  "show_description_qc": {
    "strict": true
  },
  "nle_edits": {
    "strict": true
  },
  "_comment_value_analysis": "Deterministic extract flags — auto-extract after content_context; no SSL",
  "value_analysis": {
    "enabled": true,
    "spike_scoring": true,
    "transcript_features": true,
    "audio_features": true,
    "auto_extract_after_content_context": true
  },
  "_comment_elevenlabs": "Upload limits, timeouts, chunk policy",
  "elevenlabs": {
    "max_upload_bytes": 52428800,
    "request_timeout_sec": 120,
    "max_retries": 3
  },
  "_comment_web": "GUI server port",
  "web_port": 8765,
  "_comment_local_llm": "On-device MLX volley framing before OpenAI; enabled by default on macOS bootstrap",
  "local_llm": {
    "enabled": true,
    "model_id": "mlx-community/Llama-3.2-3B-Instruct-4bit",
    "models_dir": "ASSETS/local_llm/models",
    "max_volley_turns": 2,
    "max_tokens": 768,
    "escalate_on_parse_error": true,
    "min_confidence": 0.6,
    "skip_openai_primary_when_local_satisfied": false,
    "apply_to_specialists": true,
    "apply_to_shards": true,
    "apply_to_collate": true
  },
  "_comment_analysis": "Volley caps, thresholds, orchestration; specialists run on mapped stages when enabled",
  "analysis": {
    "max_iterations_per_stage": 3,
    "max_queue_drains_per_stage": 5,
    "max_volley_retries": 2,
    "specialists": {
      "enabled": true
    },
    "prompt_examples": {
      "enabled": true
    },
    "context": {
      "transcript_excerpt_chars": 12000,
      "transcript_full_chars": 36000,
      "segment_text_max_chars": 400,
      "max_segments_in_context": 60,
      "max_segments_in_gap_pass": 35,
      "max_gap_evaluations": 50,
      "max_stage_data_chars": 32000,
      "interviewer_sample_lines": 8
    },
    "prompt_thresholds": {
      "pause_split_ms": 700,
      "short_question_max_words": 12,
      "interviewer_question_max_words": 15,
      "interviewer_setup_max_words": 20,
      "highlight_setup_max_sec": 8,
      "max_chapters": 8,
      "max_highlight_clips": 5
    }
  }
}
