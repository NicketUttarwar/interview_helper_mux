{
  "_comment_paths": "ASSETS root, executions, sample_rate, flow LUFS targets",
  "assets_root": "ASSETS",
  "input_audio_path": "ASSETS/input/interview.wav",
  "data_root": "data",
  "executions_root": "ASSETS/executions",
  "sample_rate": 48000,
  "flow1_target_lufs": -16.0,
  "flow2_target_lufs": -14.0,
  "show_description_min_words": 150,
  "show_description_max_words": 250,
  "show_description_target_words": 200,
  "_comment_models": "OpenAI tier routing per stage",
  "models": {
    "tiers": {
      "economy": "gpt-4o-mini",
      "standard": "gpt-4o",
      "flagship": "o3"
    },
    "stages": {
      "speaker_roles": { "tier": "flagship" },
      "content_context": { "tier": "flagship" },
      "content_brief_reanchor": { "tier": "flagship" },
      "boundary_detection": { "tier": "flagship" },
      "segment_classification": { "tier": "flagship" },
      "sound_design_palettes": { "tier": "flagship" },
      "missing_framing": { "tier": "flagship" },
      "optimal_questions": { "tier": "flagship" },
      "topic_coverage_audit": { "tier": "flagship" },
      "narrative_arc_plan": { "tier": "flagship" },
      "full_master_ranking": { "tier": "flagship" },
      "edl_narrative_audit": { "tier": "flagship" },
      "highlight_selection": { "tier": "flagship" },
      "podcast_show_description": { "tier": "flagship" },
      "transitions": { "tier": "flagship" },
      "podcast_sfx_brief": { "tier": "flagship" },
      "sound_design_plan_flow1": { "tier": "flagship" },
      "sound_design_plan_flow2": { "tier": "flagship" },
      "elevenlabs_prompt_craft": { "tier": "flagship" },
      "sfx_brief": { "tier": "flagship" }
    }
  },
  "_comment_mix_engine": "crossfade_ms_* and preclean acknowledgment for step-through runner",
  "mix": {
    "crossfade_ms_flow1": 100,
    "crossfade_ms_flow2": 120,
    "crossfade_ms_assembly_preview": 80,
    "require_preclean_acknowledgment": true,
    "adaptive_crossfade": true,
    "word_boundary_cuts": true,
    "word_boundary_margin_ms": 50,
    "word_boundary_max_shift_ms": 400,
    "normalize_vo_pickup": true,
    "completeness_gate": {
      "enabled": true,
      "mode": "warn"
    },
    "intelligibility_qc": {
      "enabled": false,
      "silent_speech_mix_ceiling_dbfs": -32
    }
  },
  "_comment_audio_preclean": "ElevenLabs primary; local ffmpeg denoise when API unavailable",
  "audio_preclean": {
    "local_fallback_enabled": true
  },
  "_comment_quality_gates": "G1.5, narrative/show QC strict, nle_edits.strict — production values applied in gap-closure GC-F3",
  "g1_5_require_prompt_approval": true,
  "narrative_qc": {
    "strict": true
  },
  "edl_qc": {
    "strict": true
  },
  "edl_narrative_qc": {
    "strict": true
  },
  "show_description_qc": {
    "strict": true
  },
  "nle_edits": {
    "strict": true
  },
  "_comment_value_analysis": "Deterministic extract flags — no SSL; specialists excluded (inference)",
  "value_analysis": {
    "enabled": true,
    "spike_scoring": true,
    "transcript_features": true,
    "audio_features": true,
    "auto_extract_after_content_context": true
  },
  "_comment_elevenlabs": "Music v2 compose, isolation upload limits, timeouts",
  "elevenlabs": {
    "music_model_id": "music_v2",
    "force_instrumental": true,
    "max_upload_bytes": 52428800,
    "request_timeout_sec": 120,
    "max_retries": 3
  },
  "_comment_web": "GUI server port and operator console",
  "web_port": 8765,
  "web": {
    "api_consent_persist": true
  },
  "_comment_journey_ui": "Operator journey kernel — phase sidebar, story board, unified quality drawer",
  "journey_ui": {
    "enabled": true,
    "intent_at_start": true,
    "phase_sidebar": true,
    "story_board": true,
    "unified_preclean_drawer": true,
    "express_flow1": true,
    "journey_log_filter": true,
    "require_preview_listen": false,
    "require_handoff_between_stages": true,
    "enable_stage_reuse_offers": true,
    "require_write_approval_per_stage": true
  },
  "_comment_local_llm": "On-device MLX volley framing before OpenAI; enabled by default on macOS bootstrap",
  "local_llm": {
    "enabled": true,
    "model_id": "mlx-community/Llama-3.2-3B-Instruct-4bit",
    "models_dir": "ASSETS/local_llm/models",
    "max_volley_turns": 2,
    "max_tokens": 768,
    "escalate_on_parse_error": true,
    "min_confidence": 0.6,
    "skip_openai_primary_when_local_satisfied": false,
    "apply_to_specialists": true,
    "apply_to_shards": true,
    "apply_to_collate": true
  },
  "_comment_disfluency": "Local VAD + Whisper filler detection after G0; optional EDL restore in Flow 1",
  "disfluency_extract": {
    "enabled": true,
    "whisper_model": "base",
    "compute_type": "int8",
    "gap_min_ms": 80,
    "gap_max_ms": 2500,
    "pad_ms": 80,
    "min_event_ms": 60,
    "max_events": 2000,
    "vad_energy_dbfs": -42.0,
    "weights_dir": "ASSETS/local_stt/models"
  },
  "disfluency_restore": {
    "enabled": true,
    "max_inter_segment_gap_ms": 1200,
    "crossfade_ms": 30,
    "min_speech_slice_ms": 200,
    "dedupe_overlap_ms": 40
  },
  "_comment_analysis": "Volley caps, thresholds, orchestration; specialists.pilot_stages gates post-stage passes when enabled",
  "analysis": {
    "max_iterations_per_stage": 3,
    "max_queue_drains_per_stage": 5,
    "max_volley_retries": 2,
    "llm_call_records": {
      "enabled": true,
      "write_markdown_sidecar": true
    },
    "specialists": {
      "enabled": true
    },
    "prompt_examples": {
      "enabled": true
    },
    "context": {
      "transcript_excerpt_chars": 24000,
      "transcript_full_chars": 72000,
      "speaker_roles_sample_chars": 24000,
      "max_transcript_shards": 12,
      "proactive_decompose_chars": 72000,
      "segment_text_max_chars": 400,
      "max_segments_in_context": 100,
      "max_segments_in_gap_pass": 50,
      "max_gap_evaluations": 50,
      "max_stage_data_chars": 64000,
      "interviewer_sample_lines": 8
    },
    "prompt_thresholds": {
      "pause_split_ms": 700,
      "short_question_max_words": 12,
      "interviewer_question_max_words": 15,
      "interviewer_setup_max_words": 20,
      "highlight_setup_max_sec": 8,
      "max_chapters": 8,
      "max_highlight_clips": 5
    }
  }
}
