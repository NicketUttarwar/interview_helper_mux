{
  "assets_root": "ASSETS",
  "input_audio_path": "ASSETS/input/interview.wav",
  "data_root": "data",
  "sample_rate": 48000,
  "flow1_target_lufs": -16.0,
  "flow2_target_lufs": -14.0,
  "models": {
    "tiers": {
      "economy": "gpt-4o-mini",
      "standard": "gpt-4o",
      "flagship": "o3"
    },
    "stages": {
      "speaker_roles": { "tier": "economy" },
      "content_context": { "tier": "economy" },
      "boundary_detection": { "tier": "standard" },
      "segment_classification": { "tier": "standard" },
      "missing_framing": { "tier": "flagship" },
      "optimal_questions": { "tier": "flagship" },
      "topic_coverage_audit": { "tier": "flagship" },
      "narrative_arc_plan": { "tier": "flagship" },
      "full_master_ranking": { "tier": "flagship" },
      "highlight_selection": { "tier": "flagship" },
      "podcast_show_description": { "tier": "flagship" },
      "transitions": { "tier": "economy" },
      "podcast_sfx_brief": { "tier": "economy" },
      "sfx_brief": { "tier": "economy" }
    }
  },
  "show_description_min_words": 150,
  "show_description_max_words": 250,
  "show_description_target_words": 200,
  "_comment": "Runs stored under ASSETS/executions/exec_NNN_TIMESTAMP/. Legacy data/run_NNN/ still supported.",
  "executions_root": "ASSETS/executions",
  "g1_5_require_prompt_approval": false,
  "narrative_qc": {
    "strict": false
  },
  "show_description_qc": {
    "strict": false
  },
  "value_analysis": {
    "enabled": false,
    "spike_scoring": true,
    "transcript_features": true,
    "audio_features": false,
    "auto_extract_after_content_context": false
  },
  "web_port": 8765,
  "analysis": {
    "max_iterations_per_stage": 3,
    "max_queue_drains_per_stage": 5,
    "max_volley_retries": 2,
    "specialists": {
      "enabled": false
    },
    "prompt_examples": {
      "enabled": true
    },
    "context": {
      "transcript_excerpt_chars": 12000,
      "transcript_full_chars": 36000,
      "segment_text_max_chars": 400,
      "max_segments_in_context": 60,
      "max_segments_in_gap_pass": 35,
      "max_gap_evaluations": 50,
      "max_stage_data_chars": 32000,
      "interviewer_sample_lines": 8
    },
    "prompt_thresholds": {
      "pause_split_ms": 700,
      "short_question_max_words": 12,
      "interviewer_question_max_words": 15,
      "interviewer_setup_max_words": 20,
      "highlight_setup_max_sec": 8,
      "max_chapters": 8,
      "max_highlight_clips": 5
    }
  }
}
